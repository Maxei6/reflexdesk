{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReflexDesk",
  "version": "0.1.0",
  "identifier": "io.reflexdesk.app",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "ReflexDesk",
        "url": "index.html",
        "width": 1080,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "ReflexDesk Reflex",
        "url": "overlay.html",
        "width": 430,
        "height": 430,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Local voice control for your computer and AI agents",
    "longDescription": "ReflexDesk turns speech into fast local desktop actions and can hand complex work to local planners or AI harnesses.",
    "category": "Productivity",
    "copyright": "Copyright © 2026 ReflexDesk contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
