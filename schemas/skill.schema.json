{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReflexDesk Skill",
  "description": "Versioned declarative workflow of typed ReflexDesk actions with policy control and deterministic verification.",
  "type": "object",
  "required": [
    "id",
    "version",
    "name",
    "inputs",
    "steps",
    "verification",
    "timeout_ms",
    "cancel"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$",
      "description": "Unique identifier for the skill (lowercase alphanumeric, dashes, underscores)."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version (version 2 is current; version 1 is migrated on load)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Human-readable skill name."
    },
    "description": {
      "type": "string",
      "maxLength": 1024,
      "description": "Optional human-readable description of what the skill accomplishes."
    },
    "inputs": {
      "description": "Input parameters accepted by the skill, substituted into step templates.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "enum": ["string", "number", "boolean", "object", "array"]
              },
              "default": {},
              "required": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "type": {
                "enum": ["string", "number", "boolean", "object", "array"]
              },
              "default": {},
              "required": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        }
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of policy-gated action envelope templates.",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "args",
          "risk",
          "capability",
          "verification"
        ],
        "properties": {
          "id": { "type": "string" },
          "tool": {
            "type": "string",
            "description": "Registered tool identifier from policy::tool_registry."
          },
          "args": {
            "type": "object",
            "description": "Tool argument template with optional {{input}} parameter placeholders."
          },
          "source": {
            "enum": ["reflex", "planner", "harness", "user"],
            "default": "user"
          },
          "risk": {
            "enum": ["safe", "sensitive", "destructive", "external_commit"]
          },
          "capability": {
            "type": "string"
          },
          "verification": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string" },
              "selector": { "type": ["string", "null"] },
              "expect": {},
              "timeout_ms": { "type": "integer", "minimum": 0 }
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["check"],
              "properties": {
                "check": { "type": "string" },
                "target": { "type": "string" },
                "expected": {}
              }
            }
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["kind"],
      "description": "Overall skill completion verification contract.",
      "properties": {
        "kind": { "type": "string" },
        "selector": { "type": ["string", "null"] },
        "expect": {},
        "timeout_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000,
      "description": "Global timeout in milliseconds for running the entire skill."
    },
    "cancel": {
      "type": "object",
      "required": ["allow_cancel"],
      "description": "Cancellation and cleanup policy.",
      "properties": {
        "allow_cancel": {
          "type": "boolean"
        },
        "on_cancel": {
          "type": "string",
          "enum": ["abort", "cleanup"]
        },
        "cleanup_steps": {
          "type": "array"
        }
      }
    },
    "trust": {
      "type": "object",
      "required": ["origin", "trusted"],
      "description": "Provenance and security trust metadata for imported skills.",
      "properties": {
        "origin": { "type": "string" },
        "trusted": { "type": "boolean" },
        "signature": { "type": ["string", "null"] },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imported_at": { "type": ["string", "null"] }
      }
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether the skill is enabled for execution (permission toggle / revocation)."
    }
  },
  "not": {
    "anyOf": [
      { "required": ["shell"] },
      { "required": ["cmd"] },
      { "required": ["script"] },
      { "required": ["code"] },
      { "required": ["command"] }
    ]
  }
}
