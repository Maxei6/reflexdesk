{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReflexDesk Tool",
  "type": "object",
  "required": [
    "name",
    "description",
    "risk",
    "confirmation",
    "parameters"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "safe",
        "sensitive",
        "destructive"
      ]
    },
    "confirmation": {
      "enum": [
        "never",
        "when-ambiguous",
        "always"
      ]
    },
    "parameters": {
      "type": "object"
    }
  }
}
