{
  "schema_version": 1,
  "mode": "offline",
  "general": {
    "start_at_login": true,
    "language": "auto",
    "shortcut": "CommandOrControl+Shift+Space"
  },
  "voice": {
    "enabled": true,
    "stt_provider": "nemotron",
    "stt_model": "nvidia/nemotron-3.5-asr-streaming-0.6b",
    "stt_runtime": "crispasr",
    "end_silence_ms": 340
  },
  "overlay": {
    "enabled": true,
    "size_px": {
      "width": 190,
      "height": 145
    },
    "placement": "active-monitor-bottom-center",
    "bottom_gap_px": 56,
    "click_through": true,
    "reactive_to_voice": true,
    "state_colors": true
  },
  "reflex": {
    "provider": "deterministic",
    "fallback": "laya",
    "laya_endpoint": "http://127.0.0.1:8787"
  },
  "planner": {
    "provider": "openai-compatible-local",
    "endpoint": "http://127.0.0.1:11434/v1/chat/completions",
    "model": "auto",
    "load_policy": "on-demand"
  },
  "privacy": {
    "cloud_ai_allowed": false,
    "telemetry": false,
    "stt_bind": "ephemeral-loopback",
    "stt_session_auth": true
  }
}
