{
  "manifest_version": 3,
  "name": "ReflexDesk Browser Bridge",
  "version": "0.1.0",
  "description": "Semantic DOM, accessibility, and CDP-level browser automation bridge for ReflexDesk local AI control.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "debugger",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReflexDesk Browser Bridge"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-bridge@reflexdesk.local",
      "strict_min_version": "109.0"
    }
  }
}
