{
  "manifest_version": 3,
  "name": "ReflexDesk Browser Bridge",
  "version": "0.1.0",
  "description": "Semantic DOM and accessibility automation bridge for ReflexDesk.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReflexDesk Browser Bridge"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-bridge@reflexdesk.local",
      "strict_min_version": "128.0"
    }
  }
}
